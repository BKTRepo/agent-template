# 真实运行调试开关；false 时使用明确标注的前端模拟。
VITE_REALTIME_DEBUG_ENABLED=false
# 本地联调请复制为 .env.local，填写真实后端地址及 token。
REALTIME_DEBUG_TARGET=http://127.0.0.1:8519
# token 仅由代理使用，不要加 VITE_ 前缀，也不要提交真实 token。
REALTIME_DEBUG_TOKEN=

# 本地 Skill 真实生成联调，使用现有平台后端入口。
VITE_SKILL_METADATA_READY=false
SKILL_BACKEND_TARGET=http://127.0.0.1:8520
# 仅本机联调时由代理携带测试账号的 token；正式环境沿用平台会话。
VITE_SKILL_PROXY_AUTH=false
VITE_SKILL_PROXY_ACCOUNT=skill-dev
SKILL_API_TOKEN=
