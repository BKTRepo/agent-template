# ========================================
# 基础服务与鉴权
# ========================================
# 启动前生成独立随机密钥：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace-with-a-random-secret-of-at-least-64-characters
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

APP_TITLE=FastAPI Template
APP_DESCRIPTION=通用 FastAPI 后端模板
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DEBUG=False

# ========================================
# MySQL 数据库
# ========================================
# 当前项目使用 MySQL 连接参数，不再使用旧的 DATABASE_URL / SQLite 配置。
# 请替换为目标环境的真实地址、账号和密码；不要把真实密码提交到 Git。
DATABASE_HOST=your-mysql-host
DATABASE_PORT=3306
DATABASE_NAME=your_database_name
DATABASE_USERNAME=your_database_user
DATABASE_PASSWORD=replace-with-your-database-password
# 数据库要求 TLS/SSL 加密、但暂不校验证书时设为 True。
DATABASE_SSL_ENABLED=True
# True 时仅执行已有 Aerich 迁移；生产环境通常保持 False，手动执行迁移命令。
DATABASE_AUTO_MIGRATION=False

# ========================================
# 在线调试模型：Claude Agent SDK 的兼容模型配置
# ========================================
# 以下示例为 Kimi Coding 兼容地址；替换模型供应商时统一修改此区域。
ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
ANTHROPIC_API_KEY=replace-with-your-model-api-key
ANTHROPIC_MODEL=k3-256k
ANTHROPIC_DEFAULT_OPUS_MODEL=k3-256k
ANTHROPIC_DEFAULT_SONNET_MODEL=k3-256k
ANTHROPIC_DEFAULT_HAIKU_MODEL=k3-256k
ANTHROPIC_DEFAULT_FABLE_MODEL=k3-256k
CLAUDE_CODE_SUBAGENT_MODEL=k3-256k

# Claude Agent SDK 执行参数。
CLAUDE_CODE_EFFORT_LEVEL=high
CLAUDE_CODE_AUTO_COMPACT_WINDOW=262144
CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144
