# 使用前生成独立密钥并替换下面的值：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace-with-a-random-secret-of-at-least-64-characters-before-starting
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 默认 SQLite，命令须在项目根目录执行。
DATABASE_URL=sqlite://output/template.db
# 使用 MySQL 时删除 DATABASE_URL 一行，然后设置以下参数。
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USERNAME=template_user
# DATABASE_PASSWORD=change-me
# DATABASE_NAME=template

# 默认不在启动时改表。True 仅应用已有迁移，不生成迁移文件。
DATABASE_AUTO_MIGRATION=False

APP_TITLE=FastAPI Template
APP_DESCRIPTION=通用 FastAPI 后端模板
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DEBUG=False
