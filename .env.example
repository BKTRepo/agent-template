# 数据库
DATABASE_HOST=your_host
DATABASE_PORT=your_port
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password
DATABASE_NAME=your_name

# Redis
REDIS_USERNAME=your_username
REDIS_PASSWORD=your_password
REDIS_HOST=your_host
REDIS_PORT=your_port

# 阿里云百炼 LLM 配置（OpenAI 兼容）
LLM_API_KEY=your_dashscope_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.8-flash

# 阿里云百炼 Embedding（OpenAI 兼容，用于知识库检索）
# EMBEDDING_API_KEY=your_dashscope_api_key_here
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL_NAME=qwen3.7-text-embedding

# JWT 配置（AUTH_SECRET_KEY 长度至少 64 位，建议: openssl rand -hex 32）
AUTH_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 应用配置
APP_TITLE=企业级RAG问答系统

# 测试用例生成
TEST_CASE_MODEL_POOL=sonnet;haiku;opus
TEST_CASE_MODEL_TIMEOUT=1200
TEST_CASE_SKILLS=test-case-generator
# TEST_CASE_OUTPUT_DIR=/data/agent-template/test-case

# Environment ticket review - DB1 (read-only organization directory)
TICKET_DB1_HOST=127.0.0.1
TICKET_DB1_PORT=3306
TICKET_DB1_USER=
TICKET_DB1_PASSWORD=
TICKET_DB1_NAME=
TICKET_DB1_POOL_MIN_SIZE=1
TICKET_DB1_POOL_MAX_SIZE=5
TICKET_DB1_CONNECT_TIMEOUT=10

# Environment ticket review - DB2 (review and push-task storage)
TICKET_DB2_HOST=127.0.0.1
TICKET_DB2_PORT=3306
TICKET_DB2_USER=
TICKET_DB2_PASSWORD=
TICKET_DB2_NAME=
TICKET_DB2_POOL_MIN_SIZE=1
TICKET_DB2_POOL_MAX_SIZE=5
TICKET_DB2_CONNECT_TIMEOUT=10
TICKET_MODEL_POOL=claude-sonnet-4-6;claude-opus-4-6;claude-haiku-4-5-20251001
TICKET_MODEL_TIMEOUT=1200
TICKET_MODEL_RETRY_COUNT=2
TICKET_MODEL_RETRY_DELAY=3
TICKET_SDK_MODEL_POOL=
TICKET_ANTHROPIC_MODEL=
TICKET_COCO_BATCH_SIZE=10
TICKET_PUSH_TASK_WORKER_ENABLED=true
TICKET_PUSH_TASK_POLL_INTERVAL=2
TICKET_PUSH_TASK_BATCH_SIZE=5
TICKET_PUSH_TASK_RETENTION_DAYS=7
TICKET_PUSH_TASK_CLEANUP_INTERVAL=3600
TICKET_PUSH_TASK_STALE_PROCESSING_SECONDS=1800
TICKET_PUSH_TASK_FAILED_RETRY_DELAY_SECONDS=86400
TICKET_PUSH_TASK_SSE_HEARTBEAT_SECONDS=15
TICKET_PUSH_TASK_HEARTBEAT_INTERVAL_SECONDS=60

# Code Server IDE database
IDE_DATABASE_HOST=127.0.0.1
IDE_DATABASE_PORT=3306
IDE_DATABASE_USER=
IDE_DATABASE_PASSWORD=
IDE_DATABASE_NAME=
IDE_DATABASE_ECHO=false

# Code Server IDE runtime
IDE_IMAGE=coco-code-server:amd64-20260730
IDE_DOCKER_NETWORK=coco-ide-net
IDE_CONTAINER_PREFIX=ide-code-server
IDE_SESSIONS_ROOT=~/claude_engineering/ide-sessions
IDE_CODE_SERVER_AUTH=none
IDE_AUTH_COOKIE_NAME=ide_access_token
IDE_UID=1001
IDE_BASE_HOST_PORT=18081
IDE_HOST_PORT_RANGE=1000
IDE_MEMORY_LIMIT=2g
IDE_MEMORY_SWAP_LIMIT=2g
IDE_CPU_LIMIT=2
IDE_PIDS_LIMIT=512
COCO_NPM_REGISTRY=https://registry.npmmirror.com
COCO_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
COCO_PIP_TRUSTED_HOST=mirrors.aliyun.com
IDE_MAX_RUNNING_CONTAINERS=0
IDE_IDLE_STOP_MINUTES=30
IDE_IDLE_PENDING_MINUTES=5
IDE_STOPPING_TIMEOUT_MINUTES=5
IDE_DOCKER_STOP_TIMEOUT_SECONDS=30
IDE_STOPPED_CONTAINER_RM_MINUTES=1440
IDE_BUSY_FILE_WINDOW_MINUTES=2
IDE_BUSY_CPU_THRESHOLD=2
IDE_BUSY_MAX_HOURS=6
IDE_DATA_RETENTION_DAYS=7
IDE_ALLOW_VIEW_OTHER_USERS_PROJECTS=true
IDE_ALLOW_CROSS_USER_EDIT_IN_SYSTEM=false

# jiayueyang RAG 文档流水线（Python 3.13）
RAG_OUTPUT_DIR=./output/rag_upload
RAG_INPUT_DIR=./input
RAG_MAX_UPLOAD_MB=200
PDF_SPLIT_MAX_PAGES=25
MAX_PARALLEL_PARSE_DOCLING=1
DOCLING_PDF_BACKEND=pypdfium2
DOCLING_USE_GPU=false
DOCLING_FORMULA_ENRICHMENT=false
DOCLING_TABLE_STRUCTURE=true
DOCLING_PICTURE_CLASSIFICATION=true
DOCLING_PICTURE_DESCRIPTION=false

# 新 RAG 分块/检索参数；CHUNK_SIZE 同时作为旧知识库的默认分块大小
CHUNK_SIZE=800
CHUNK_OVERLAP_SIZE=100
TABLE_ROW_CHUNKS=true
CHUNK_TOP_K=100
RRF_TOP_K=100
HYBRID_DENSE_TOP_K=60
HYBRID_BM25_TOP_K=60
RAG_CONTEXT_TOP_K=20
MAX_TOTAL_TOKENS=30000
DOC_BUDGET_MAX_SHARE=0.6
DOC_RECALL_ENABLED=true
DOC_RECALL_MIN_SCORE=0.5
DOC_RECALL_CHUNKS_PER_DOC=8
DOC_RECALL_MAX_DOCS=3
DOC_RECALL_INDEX_TTL=30

# 采纳经验查询指导（历史文档加权并保留全库候选，不复用历史答案）
QUERY_MEMORY_ENABLED=true
QUERY_MEMORY_SHADOW_MODE=false
QUERY_MEMORY_SCOPED_SEARCH_ENABLED=false
QUERY_MEMORY_GUIDED_WEIGHT=1.2
QUERY_MEMORY_GLOBAL_MIN_RATIO=0.30
QUERY_MEMORY_TOP_K=5
QUERY_MEMORY_MIN_SCORE=0.72
LEARNED_MAPPING_MIN_EVIDENCE=2
MAPPING_EVIDENCE_MIN_SCORE=0.72
MAPPING_EVIDENCE_MIN_CONFIDENCE=0.80
MAPPING_EVIDENCE_CENTROID_MIN_SCORE=0.90
MAPPING_EXTRACTION_ENABLED=true
DOC_SUMMARY_INPUT_MAX_CHARS=20000
SUBQUERY_DECOMPOSE_ENABLED=true
SUBQUERY_MAX_COUNT=4
SUBQUERY_CANDIDATE_TOP_K=3
SUBQUERY_MAX_TOKENS=800
SUBQUERY_MAX_LENGTH=40
SUBQUERY_TRUNCATION_RETRY_ENABLED=true
SUBQUERY_RULE_FALLBACK_ENABLED=true
SUBQUERY_FALLBACK_CACHE_TTL=300
SUBQUERY_QUOTA_BACKFILL_ENABLED=true
SUBQUERY_MIN_FINAL_CHUNKS=1
SUBQUERY_BACKFILL_MAX_TOTAL=3
SUBQUERY_BACKFILL_MIN_SCORE=0
SUBQUERY_BACKFILL_REQUIRE_ANCHOR=false
ANSWER_TRUNCATION_RETRY_ENABLED=true
ANSWER_PARTIAL_FALLBACK_ENABLED=true
ANSWER_CONCISE_RETRY_MAX_CHARS=1500
FIELD_VARIANT_NORMALIZATION_ENABLED=true

# Milvus Server（仅支持 C/S 架构）
VECTOR_UPSERT_BATCH_SIZE=500
MILVUS_URI=http://127.0.0.1:19530
# MILVUS_USER=
# MILVUS_PASSWORD=
MILVUS_POOL_SIZE=8
MILVUS_POOL_ACQUIRE_TIMEOUT=30

# 新 RAG 的 LLM/Embedding/Rerank（阿里云百炼兼容接口）
LLM_MODEL=qwen3.8-flash
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7
EMBEDDING_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BINDING_API_KEY=your_dashscope_api_key_here
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
EMBEDDING_BATCH_NUM=20
EMBEDDING_MAX_CONCURRENT=3
EMBEDDING_MAX_CHARS_PER_TEXT=5000
EMBEDDING_SEND_DIM=true
EMBEDDING_USE_BASE64=true
RERANK_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
RERANK_BINDING_API_KEY=your_dashscope_api_key_here
RERANK_MODEL=qwen3.7-text-rerank
RERANK_ENABLE_CHUNKING=true
RERANK_MAX_TOKENS_PER_DOC=480
RERANK_TOP_K=50
RERANK_MIN_SCORE=0
ENABLE_VLM=false
VLM_API_BASE=http://127.0.0.1:11434/v1
VLM_API_KEY=not-needed
VLM_MODEL=gpt-4o
