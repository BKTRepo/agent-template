# 数据库
DATABASE_HOST=your_host
DATABASE_PORT=your_port
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password
DATABASE_NAME=your_name
# 所有环境关闭服务启动时自动建表/迁移，表结构由显式迁移维护。
DATABASE_AUTO_MIGRATION=false
# 云数据库要求加密连接时启用。若老师提供 CA 证书，再填写 DATABASE_SSL_CA 以校验服务器身份。
DATABASE_SSL_ENABLED=false
# DATABASE_SSL_CA=D:/certs/ca.pem
# DATABASE_SSL_CERT=D:/certs/client-cert.pem
# DATABASE_SSL_KEY=D:/certs/client-key.pem

# Redis
REDIS_USERNAME=your_username
REDIS_PASSWORD=your_password
REDIS_HOST=your_host
REDIS_PORT=your_port

# ChromaDB 本地向量库（目录: backend/core/chroma_db）
CHROMA_COLLECTION=knowledge_base

# DeepSeek LLM 配置（OpenAI 兼容）
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# Embedding 向量（硅基流动，用于知识库检索；与 LLM Key 不同）
# 注册地址：https://cloud.siliconflow.cn/
# EMBEDDING_API_KEY=your_siliconflow_api_key_here
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5

# JWT 配置（AUTH_SECRET_KEY 长度至少 64 位，建议: openssl rand -hex 32）
AUTH_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 应用配置
APP_TITLE=FastAPI Template

# Skill 解析引擎（可选；默认保存到项目 output/skill-builds）
# SKILL_BUILD_DIR=D:/skill-builds
# 20261016 定稿：Skill 直接上传单文件及合计均为 50MiB；知识库上传不使用这两个限制。
SKILL_RESOURCE_MAX_BYTES=52428800
SKILL_RESOURCE_TOTAL_MAX_BYTES=52428800
# JSON 数组；生产环境需接入行内全量应用目录，不接受任意自由输入。
# PLATFORM_APPLICATIONS=["核心系统","ATPM"]
# KNOWLEDGE_PDF_DOCLING=true
# 可复用现有 RAG 的向量模型配置；只读 Embedding 三项，不连接旧数据库。
# KNOWLEDGE_RAG_ENV_FILE=D:/projects/agent-template-release-qoder/.env
# 正式默认 Celery；必须启动 knowledge_parse、knowledge_delete 两个 Worker 和 Beat。
KNOWLEDGE_TASK_MODE=celery
KNOWLEDGE_CANCEL_POLL_SECONDS=1
KNOWLEDGE_DELETE_MAX_RETRIES=12
# 仅单机演示／隔离测试可显式使用 inline，不提供跨进程锁和自动重试。
APP_DESCRIPTION=通用 FastAPI 后端模板
SERVER_HOST=0.0.0.0
SERVER_PORT=8519
SERVER_DEBUG=False

# 在线沙箱使用的 Anthropic 兼容模型；真实密钥仅放在本机 .env。
ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
ANTHROPIC_API_KEY=replace-with-your-model-api-key
ANTHROPIC_MODEL=k3-256k
ANTHROPIC_DEFAULT_OPUS_MODEL=k3-256k
ANTHROPIC_DEFAULT_SONNET_MODEL=k3-256k
ANTHROPIC_DEFAULT_HAIKU_MODEL=k3-256k
ANTHROPIC_DEFAULT_FABLE_MODEL=k3-256k
CLAUDE_CODE_SUBAGENT_MODEL=k3-256k
CLAUDE_CODE_EFFORT_LEVEL=high
CLAUDE_CODE_AUTO_COMPACT_WINDOW=262144
CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144
