KNOWLEDGE_TASK_MODE=celery
KNOWLEDGE_PDF_DOCLING=false
ASSISTANT_ARTIFACT_MODEL_GROUPING=true
USER_DEPARTMENT_MODE=disabled
USER_DEPARTMENT_DB_HOST=
USER_DEPARTMENT_DB_PORT=3306
USER_DEPARTMENT_DB_NAME=
USER_DEPARTMENT_DB_USERNAME=
USER_DEPARTMENT_DB_PASSWORD=
USER_DEPARTMENT_DB_SSL_ENABLED=true
USER_DEPARTMENT_DB_SSL_CA=

# 内网 OpenAI 兼容接口。基础地址以 /v1 结尾，不加末尾斜杠。
INTRANET_OPENAI_BASE_URL=http://10.240.192.142:30003/v1
INTRANET_CHAT_MODEL=deepseek-v4-flash-local-thinkl
INTRANET_MODEL_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_USE_BASE64=false
RERANK_MODEL=bge-rerank-v2-m3
VLM_API_BASE=
VLM_API_KEY=
VLM_MODEL=

CHAT_MODEL_REGISTRY=
CHAT_DEFAULT_MODEL=
