# Docker 主机上的绝对路径。WSL 建议放在 Linux 文件系统内。
PLATFORM_DATA_DIR=/zdhgj/keenrobo/app
# Docker 宿主机的数据服务根目录。
DATABASE_DATA_ROOT=/zdhgj/keenrobo
PLATFORM_IMAGE=keenrobot-platform:uat-bundled
PLATFORM_PORT=3000
PLATFORM_BIND_ADDRESS=0.0.0.0
PLATFORM_DOCKER_SOCKET=/var/run/docker.sock
COMPOSE_PROJECT_NAME=keenrobot-platform

AUTH_SECRET_KEY=
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USERNAME=keenrobot
DATABASE_PASSWORD=
DATABASE_NAME=keenrobot
DATABASE_SSL_ENABLED=false
DATABASE_SSL_CA=
MYSQL_ROOT_PASSWORD=
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
MILVUS_URI=http://milvus:19530
MINIO_ROOT_USER=keenrobot
MINIO_ROOT_PASSWORD=
MILVUS_TOKEN=
MILVUS_USER=
MILVUS_PASSWORD=

APPLICATION_CATALOG_MODE=mock
APPLICATION_CATALOG_URL=
